# ============================================================
# Auth (aut) Domain — Local Development Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# All microservices under /aut (vec, vce, vck, vsc, etc.)
# share these same variables. Load via IntelliJ EnvFile plugin.
# ============================================================

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=dev

# --- PostgreSQL (aut domain database) ---
AUT_DB_URL=jdbc:postgresql://localhost:5432/aut_db
AUT_DB_USER=
AUT_DB_PASSWORD=

# --- Redis (aut domain cache) ---
AUT_REDIS_HOST=localhost
AUT_REDIS_PORT=6379
AUT_REDIS_PASSWORD=
